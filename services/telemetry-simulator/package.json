{
  "name": "@technical-test/telemetry-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/service.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/service.js",
    "simulate:segment": "tsx src/publishSegment.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
