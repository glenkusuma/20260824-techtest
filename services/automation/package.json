{
  "name": "@technical-test/automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/collect.js",
    "collect": "tsx src/collect.ts",
    "db:reset:demo": "tsx src/scripts/resetDemoCollectorDb.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cleanup": "bash scripts/cleanup.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
