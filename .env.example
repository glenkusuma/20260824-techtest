# Local npm runtime. Node/Vite services load this repository-level file when present.
NODE_ENV=development

# Use the normal application database for local development/demo seeding.
DB_TIER=prod
PORT=3000
DATABASE_PATH=.runtime/backend/application.db

# Public URL advertised by OpenAPI and browser origin allowed by the backend.
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=10000
HTTP_LOGGING=true

# Frontend runtime/build values (Vite reads the repository root via envDir).
VITE_API_BASE_URL=http://localhost:3000
VITE_DEMO_MODE=false

# Simulator -> backend HTTP boundary.
BACKEND_URL=http://localhost:3000
SIMULATOR_CADENCE_MS=300000

# Collector state and archive output.
COLLECTOR_DB_TIER=prod
COLLECTOR_DATABASE_PATH=.runtime/automation/collector.db
ARTIFACT_DIR=.runtime/cron
COLLECTION_SOURCE_NAME=backend-telemetry
COLLECTION_PAGE_SIZE=500
RETENTION_DAYS=30
